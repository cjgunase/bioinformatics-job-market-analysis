{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cjgunase.github.io/schemas/bioinformatics-job-market-analysis/jobs.schema.json",
  "title": "Bioinformatics job record",
  "description": "One screened job record for BSE-JMA-001 specification 1.1.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "job_id",
    "canonical_job_id",
    "company_name_raw",
    "company_name_normalized",
    "company_domain",
    "title_raw",
    "title_normalized",
    "role_family",
    "seniority",
    "sector",
    "employment_type",
    "location_raw",
    "country",
    "state",
    "city",
    "location_mode",
    "us_eligible",
    "salary_min",
    "salary_max",
    "salary_currency",
    "salary_period",
    "posting_date",
    "first_seen_at",
    "last_verified_at",
    "active_at_freeze",
    "canonical_url",
    "discovery_url",
    "source_type",
    "requisition_id",
    "description_sha256",
    "template_fingerprint",
    "full_text_path",
    "selection_status",
    "inclusion_decision",
    "decision_reason_code",
    "decision_rationale",
    "inclusion_confidence",
    "duplicate_cluster_id",
    "replacement_for_job_id",
    "human_review_status"
  ],
  "properties": {
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "job_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "canonical_job_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "company_name_raw": {
      "$ref": "#/$defs/nonempty_string"
    },
    "company_name_normalized": {
      "$ref": "#/$defs/nonempty_string"
    },
    "company_domain": {
      "type": "string",
      "format": "hostname"
    },
    "title_raw": {
      "$ref": "#/$defs/nonempty_string"
    },
    "title_normalized": {
      "$ref": "#/$defs/nonempty_string"
    },
    "role_family": {
      "type": "string",
      "enum": [
        "bioinformatics_engineering",
        "computational_biology_science",
        "scientific_software_platform",
        "data_workflow_infrastructure",
        "ai_ml_for_biology",
        "technical_leadership_management"
      ]
    },
    "seniority": {
      "type": "string",
      "enum": [
        "entry_associate",
        "mid_level",
        "senior_plus",
        "unspecified"
      ]
    },
    "sector": {
      "type": "string",
      "enum": [
        "biopharma",
        "biotechnology_tools",
        "diagnostics_clinical_labs",
        "genomics_sequencing",
        "health_tech",
        "ai_enabled_drug_discovery",
        "contract_research_services",
        "scientific_software_platform",
        "other_life_science"
      ]
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "fixed_term",
        "contract"
      ]
    },
    "location_raw": {
      "$ref": "#/$defs/nonempty_string"
    },
    "country": {
      "const": "US"
    },
    "state": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "city": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "location_mode": {
      "type": "string",
      "enum": [
        "onsite",
        "hybrid",
        "remote",
        "unspecified"
      ]
    },
    "us_eligible": {
      "type": "boolean"
    },
    "salary_min": {
      "$ref": "#/$defs/nullable_nonnegative_number"
    },
    "salary_max": {
      "$ref": "#/$defs/nullable_nonnegative_number"
    },
    "salary_currency": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "salary_period": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "posting_date": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "active_at_freeze": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "discovery_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "employer_career_page",
        "employer_operated_ats",
        "employer_authenticated_platform",
        "reputable_job_board",
        "discovery_only"
      ]
    },
    "requisition_id": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "description_sha256": {
      "$ref": "#/$defs/nullable_sha256"
    },
    "template_fingerprint": {
      "$ref": "#/$defs/nullable_sha256"
    },
    "full_text_path": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "selection_status": {
      "type": "string",
      "enum": [
        "candidate",
        "excluded",
        "eligible",
        "included",
        "reserve",
        "replaced"
      ]
    },
    "inclusion_decision": {
      "type": "string",
      "enum": [
        "pending",
        "include",
        "exclude",
        "pending_human"
      ]
    },
    "decision_reason_code": {
      "type": "string",
      "enum": [
        "include_meets_all",
        "exclude_academic",
        "exclude_internship",
        "exclude_wet_lab",
        "exclude_not_life_science",
        "exclude_not_engineering",
        "exclude_geography",
        "exclude_inactive",
        "exclude_incomplete_text",
        "exclude_duplicate",
        "exclude_company_cap",
        "exclude_template_cap",
        "exclude_source_unverifiable",
        "pending_human",
        "reserve_quota"
      ]
    },
    "decision_rationale": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "inclusion_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "duplicate_cluster_id": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "replacement_for_job_id": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "human_review_status": {
      "type": "string",
      "enum": [
        "not_reviewed",
        "pending",
        "approved",
        "rejected"
      ]
    }
  },
  "$defs": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])_bioinfo_jobs_us_v[0-9]{2}$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_nonempty_string": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonempty_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_nonnegative_number": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
