{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cjgunase.github.io/schemas/bioinformatics-job-market-analysis/runs.schema.json",
  "title": "Bioinformatics job-market analysis run",
  "description": "One run-metadata record for BSE-JMA-001 specification 1.1.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "spec_version",
    "taxonomy_version",
    "pipeline_version",
    "collection_started_at",
    "collection_closed_at",
    "publication_month",
    "target_n",
    "included_n",
    "candidate_n",
    "reserve_n",
    "previous_run_id",
    "git_commit",
    "status",
    "human_reviewer",
    "freeze_timestamp",
    "notes"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])_bioinfo_jobs_us_v[0-9]{2}$"
    },
    "spec_version": {
      "const": "1.1.1"
    },
    "taxonomy_version": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pipeline_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "config_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "collection_started_at": {
      "$ref": "#/$defs/nullable_timestamp"
    },
    "collection_closed_at": {
      "$ref": "#/$defs/nullable_timestamp"
    },
    "publication_month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "target_n": {
      "const": 150
    },
    "included_n": {
      "type": "integer",
      "minimum": 0,
      "maximum": 150
    },
    "candidate_n": {
      "type": "integer",
      "minimum": 0
    },
    "reserve_n": {
      "type": "integer",
      "minimum": 0
    },
    "previous_run_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])_bioinfo_jobs_us_v[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "git_commit": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256_or_git_commit"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "initialized",
        "collecting",
        "screening",
        "frozen_draft",
        "analyzing",
        "awaiting_human_review",
        "draft_not_human_verified",
        "approved",
        "published",
        "blocked",
        "failed"
      ]
    },
    "human_reviewer": {
      "$ref": "#/$defs/nullable_nonempty_string"
    },
    "freeze_timestamp": {
      "$ref": "#/$defs/nullable_timestamp"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "nullable_timestamp": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_nonempty_string": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256_or_git_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    }
  }
}
